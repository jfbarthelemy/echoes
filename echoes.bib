@article{saevik2014,
  title = {Anisotropic Effective Conductivity in Fractured Rocks by Explicit Effective Medium Methods},
  author = {Saevik, Pål Naeverlid and Jakobsen, Morten and Lien, Martha and Berre, Inga},
